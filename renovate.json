{
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "matchDepTypes": ["*"],
      "groupName": "minor/patch updates",
      "allowedVersions": "/.*/",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchPackagePatterns": ["*"],
      "matchDepTypes": ["*"],
      "matchUpdateTypes": ["major"],
      "groupName": null
    }
  ],
  "schedule": ["daily"]
}
